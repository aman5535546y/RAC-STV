# Rotaract STV Portal Environment Variables Configuration
# Copy this file to .env for local development or set these in your deployment platform (Vercel/Netlify/Firebase)

# 1. Google OAuth 2.0 Web Client ID (From Google Cloud Console: APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Firebase Web API Key (From Firebase Console: Project Settings > General)
VITE_FIREBASE_API_KEY=AIzaSyYourLiveFirebaseApiKeyHere

# 3. Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=rotaract-stv.firebaseapp.com

# 4. Firebase Project ID
VITE_FIREBASE_PROJECT_ID=rotaract-stv
